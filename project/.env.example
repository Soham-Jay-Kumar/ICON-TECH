# Where /api/demo-request forwards submissions from the Schedule a Demo form.
# Any endpoint that accepts a JSON POST works: a CRM intake URL, an inbox
# automation (Zapier/Make/n8n), a Slack incoming webhook, or an internal API.
#
# Server-side only — do NOT rename this to NEXT_PUBLIC_*, or the endpoint ends
# up in the client bundle and becomes writable by anyone who views source.
#
# If this is unset the route returns 503 and the form tells the visitor the
# request could not be sent, rather than silently dropping the lead.
DEMO_REQUEST_WEBHOOK_URL=

# Absolute base URL of the deployment, used for metadataBase (Open Graph and
# Twitter image URLs), robots.txt and sitemap.xml.
#
# Netlify sets `URL` automatically at build time, so this is only needed if the
# canonical domain differs from the Netlify one. Local builds fall back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
